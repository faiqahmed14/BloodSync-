MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bloodsync?retryWrites=true&w=majority
PORT=4000

# Generate once with: npm run generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@example.com

# How long a wave waits for an acceptance before escalating, in milliseconds (default 5 min).
# Use something small like 15000 while testing so you can see escalation quickly.
WAVE_TIMEOUT_MS=300000

# ---- Maps ----
# Default (leave this out): FREE maps using Leaflet + OpenFreeMap tiles with English labels, and free
# OSRM routing. No key, no account, no credit card.
# MAP_PROVIDER=osm
#
# Optional: use Google Maps instead. Google requires a Cloud billing account (a card on file, even
# though there is a free monthly allowance). Then enable "Maps JavaScript API" and "Routes API":
# MAP_PROVIDER=google
# GOOGLE_MAPS_API_KEY=
# GOOGLE_ROUTES_API_KEY=      (optional separate server-only key; defaults to GOOGLE_MAPS_API_KEY)
# GOOGLE_MAPS_MAP_ID=         (optional; defaults to Google's DEMO_MAP_ID)
# GOOGLE_ROUTES_TRAFFIC=false (true = traffic-aware ETAs, a higher Google pricing tier)

# Routing server (default: the free public OSRM demo server; also the fallback if Google routing fails).
# OSRM_BASE_URL=https://router.project-osrm.org

# ---- Going live (see ../DEPLOY.md) ----
# NODE_ENV=production
# Your website address(es), comma separated. Strongly recommended in production.
# CORS_ORIGINS=https://your-site.vercel.app,https://your-project-*-yourteam.vercel.app   (* matches one chunk, handy for Vercel previews)
# Turns on the private GET /api/donors list for admins (sent as an x-admin-token header). Leave unset to keep it off.
# ADMIN_TOKEN=
# FORCE_HTTPS=false     (turn off the automatic http to https redirect)
# RATE_LIMIT=off        (turn off abuse protection, for testing only)
# DB_CONNECT_ATTEMPTS=4 (database connection retries at start-up)
